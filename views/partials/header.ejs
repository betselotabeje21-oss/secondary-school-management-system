<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= appTitle %></title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand-box">
        <div>
          <h2><%= settings.school_name %></h2>
        </div>
      </div>

      <nav class="main-nav">
        <a class="nav-link <%= active === 'dashboard' ? 'active' : '' %>" href="<%= user ? dashboardPath : '/login' %>">Dashboard</a>
        <% if (user && ['admin','teacher'].includes(user.role)) { %>
          <a class="nav-link <%= active === 'students' ? 'active' : '' %>" href="/students">Students</a>
          <a class="nav-link <%= active === 'teachers' ? 'active' : '' %>" href="/teachers">Teachers</a>
          <a class="nav-link <%= active === 'classes' ? 'active' : '' %>" href="/classes">Classes</a>
          <a class="nav-link <%= active === 'subjects' ? 'active' : '' %>" href="/subjects">Subjects</a>
          <a class="nav-link <%= active === 'attendance' ? 'active' : '' %>" href="/attendance">Attendance</a>
          <a class="nav-link <%= active === 'examinations' ? 'active' : '' %>" href="/examinations">Examinations</a>
          <a class="nav-link <%= active === 'reports' ? 'active' : '' %>" href="/reports">Reports</a>
          <a class="nav-link <%= active === 'announcements' ? 'active' : '' %>" href="/announcements">Announcements</a>
        <% } else if (user && user.role === 'student') { %>
          <a class="nav-link <%= active === 'profile' ? 'active' : '' %>" href="/profile">My Profile</a>
          <a class="nav-link <%= active === 'reports' ? 'active' : '' %>" href="/reports">Report Card</a>
          <a class="nav-link <%= active === 'announcements' ? 'active' : '' %>" href="/announcements">Announcements</a>
        <% } else if (user && user.role === 'parent') { %>
          <a class="nav-link <%= active === 'profile' ? 'active' : '' %>" href="/profile">Children</a>
          <a class="nav-link <%= active === 'reports' ? 'active' : '' %>" href="/reports">Academic Results</a>
          <a class="nav-link <%= active === 'announcements' ? 'active' : '' %>" href="/announcements">Announcements</a>
        <% } %>

        <% if (user && user.role === 'admin') { %>
          <a class="nav-link <%= active === 'settings' ? 'active' : '' %>" href="/settings">Settings</a>
        <% } %>
      </nav>
    </aside>

    <main class="main-panel">
      <header class="topbar">
        <div class="topbar-title">
          <button class="nav-toggle" type="button">☰</button>
          <div>
            <span class="eyebrow"><%= appTitle %></span>
            <h1><%= title %></h1>
          </div>
        </div>

        <div class="topbar-actions">
          <div class="pill">Academic year: <strong><%= settings.academic_year %></strong></div>
          <% if (user) { %>
            <div class="user-menu">
              <div class="avatar"><%= user.name.slice(0, 1).toUpperCase() %></div>
              <div>
                <strong><%= user.name %></strong>
                <small><%= user.role %></small>
              </div>
              <a class="small-link" href="/profile">Profile</a>
              <a class="small-link danger" href="/logout">Logout</a>
            </div>
          <% } %>
        </div>
      </header>

      <div class="page-body">
