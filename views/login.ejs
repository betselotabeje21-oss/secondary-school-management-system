<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In | <%= settings.school_name %></title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="auth-page">
  <a class="back-home" href="/">← Back to Home</a>
  <div class="login-box">
    <div class="login-brand">
      <h1><%= settings.school_name %></h1>
    </div>

    <form class="auth-form" method="POST" action="/login">
      <h2>Sign in</h2>
      <% if (error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>

      <label>
        <span>Email</span>
        <input type="email" name="email" value="<%= email || '' %>" placeholder="admin@bemilew.edu" autocomplete="username" required />
      </label>

      <label>
        <span>Password</span>
        <span class="password-field">
          <input type="password" name="password" placeholder="Enter password" autocomplete="current-password" required />
          <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false">
            <svg class="eye-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </span>
      </label>

      <button type="submit" class="primary-btn">Sign In</button>
    </form>

    <div class="demo-accounts">
      <h3>Demo accounts</h3>
      <ul>
        <li><strong>Admin:</strong> admin@bemilew.edu / Admin123!</li>
        <li><strong>Teacher:</strong> teacher@bemilew.edu / Teacher123!</li>
        <li><strong>Student:</strong> student@bemilew.edu / Student123!</li>
        <li><strong>Parent:</strong> parent@bemilew.edu / Parent123!</li>
      </ul>
    </div>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
