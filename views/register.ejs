<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account | <%= settings.school_name %></title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-page">
  <header class="auth-page-header">
    <a class="back-home" href="/login">← Back to Sign In</a>
    <%- include('partials/language-selector') %>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.7 8.7 0 1 0 20.2 15.1Z"></path></svg>
    </button>
  </header>
  <main class="login-box auth-box-single">
    <section class="auth-form">
      <span class="eyebrow">Yemilew Secondary School</span>
      <h1 class="auth-page-title">Create your account</h1>
      <p class="auth-help">Students and parents can create a portal account. Teacher and administrator accounts are provisioned by the school.</p>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <form class="stack-form" method="POST" action="/register" data-auth-loading>
        <label><span>Full Name</span><input type="text" name="name" value="<%= name || '' %>" autocomplete="name" minlength="2" maxlength="100" required /></label>
        <label><span>Email Address</span><input type="email" name="email" value="<%= email || '' %>" placeholder="name@gmail.com" autocomplete="email" maxlength="254" required /></label>
        <label><span>Account Role</span>
          <select name="role" required>
            <option value="student" <%= role === 'student' ? 'selected' : '' %>>Student</option>
            <option value="parent" <%= role === 'parent' ? 'selected' : '' %>>Parent</option>
          </select>
        </label>
        <label><span>Password</span>
          <span class="password-field">
            <input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="128" required />
            <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false"><img src="/icons/eye.svg" alt="" aria-hidden="true" /></button>
          </span>
        </label>
        <label><span>Confirm Password</span>
          <span class="password-field">
            <input type="password" name="confirmPassword" autocomplete="new-password" minlength="10" maxlength="128" required />
            <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false"><img src="/icons/eye.svg" alt="" aria-hidden="true" /></button>
          </span>
        </label>
        <label class="checkbox-row terms-row">
          <input class="checkbox-input" type="checkbox" name="acceptTerms" required />
          <span>I agree to the <details class="terms-details"><summary>Terms and Conditions</summary><p>Use your own account, keep your password private, and access only school information you are authorized to view.</p></details></span>
        </label>
        <button type="submit" class="primary-btn">Create Account</button>
      </form>
      <p class="auth-register-prompt">Already registered? <a class="auth-text-link" href="/login">Sign In</a></p>
    </section>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
