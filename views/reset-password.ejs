<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | <%= settings.school_name %></title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-page">
  <header class="auth-page-header">
    <a class="back-home" href="/login">← Back to Sign In</a>
    <%- include('partials/language-selector') %>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l-1.42-1.42m11.3-11.3 1.42 1.42"></path></svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.7 8.7 0 1 0 20.2 15.1Z"></path></svg>
    </button>
  </header>
  <main class="login-box auth-box-single">
    <section class="auth-form">
      <span class="eyebrow">Secure account recovery</span>
      <h1 class="auth-page-title">Set a new password</h1>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <% if (token) { %>
        <form class="stack-form" method="POST" action="/reset-password" data-auth-loading>
          <input type="hidden" name="token" value="<%= token %>" />
          <label><span>New Password</span>
            <span class="password-field">
              <input type="password" name="password" autocomplete="new-password" minlength="10" maxlength="128" required />
              <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false"><img src="/icons/eye.svg" alt="" aria-hidden="true" /></button>
            </span>
          </label>
          <label><span>Confirm New Password</span>
            <span class="password-field">
              <input type="password" name="confirmPassword" autocomplete="new-password" minlength="10" maxlength="128" required />
              <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false"><img src="/icons/eye.svg" alt="" aria-hidden="true" /></button>
            </span>
          </label>
          <button type="submit" class="primary-btn">Update Password</button>
        </form>
      <% } else { %>
        <p class="auth-help">Request a new reset link to continue.</p>
        <a class="primary-btn" href="/forgot-password">Request Reset Link</a>
      <% } %>
    </section>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
