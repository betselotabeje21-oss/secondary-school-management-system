<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | <%= settings.school_name %></title>
  <%- include('partials/theme-init') %>
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="auth-page">
  <header class="auth-page-header">
    <a class="back-home" href="/login">← Back to Sign In</a>
    <%- include('partials/language-selector') %>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.7 8.7 0 1 0 20.2 15.1Z"></path></svg>
    </button>
  </header>
  <main class="login-box auth-box-single">
    <section class="auth-form">
      <span class="eyebrow">Account recovery</span>
      <h1 class="auth-page-title">Forgot your password?</h1>
      <p class="auth-help">Enter the email address linked to your school account. If it matches, we’ll send a time-limited reset link.</p>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <% if (notice) { %><div class="alert success" role="status"><%= notice %></div><% } %>
      <form class="stack-form" method="POST" action="/forgot-password" data-auth-loading>
        <label><span>Email Address</span><input type="email" name="email" value="<%= email || '' %>" autocomplete="email" maxlength="254" required /></label>
        <button type="submit" class="primary-btn">Send Reset Link</button>
      </form>
      <p class="auth-register-prompt"><a class="auth-text-link" href="/login">Return to Sign In</a></p>
    </section>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
