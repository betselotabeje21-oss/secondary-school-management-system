<%- include('partials/header') %>

<div class="panel">
  <div class="panel-header"><h3>Student Report Cards</h3></div>
  <table>
    <thead>
      <tr>
        <th>Student</th>
        <th>Student ID</th>
        <th>Exam</th>
        <th>Subject</th>
        <th>Marks</th>
      </tr>
    </thead>
    <tbody>
      <% if (grades && grades.length) { %>
        <% grades.forEach((entry) => { %>
          <% const student = students.find((s) => s.id === entry.student_id); %>
          <tr>
            <td><%= student ? student.first_name + ' ' + student.last_name : 'Unknown' %></td>
            <td><%= student ? student.student_id : '—' %></td>
            <td><%= entry.exam_name %></td>
            <td><%= entry.subject_name %></td>
            <td><%= entry.marks %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="5">No report data exists.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
