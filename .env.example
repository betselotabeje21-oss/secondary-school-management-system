NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# OAuth 2.0 Web application client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# SMTP credentials from your mail provider. Use an app password where supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
